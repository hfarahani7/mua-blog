# Copy to .env for local development. Never commit .env.
# EmailJS values (public by design; also set as GitHub Actions repository VARIABLES).
# Find them at https://dashboard.emailjs.com/admin

# Account > API Keys > Public Key
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Email Services > Service ID (looks like service_xxxxxxx)
PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx

# Email Templates > Template ID (looks like template_xxxxxxx)
PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# Where inquiries are sent (passed to the template as to_email)
PUBLIC_OWNER_EMAIL=you@example.com

# Only for "npm run sync" (image-sync.js). Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=