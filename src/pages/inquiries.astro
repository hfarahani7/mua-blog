---
// Inquiries: Stitch inquiry split — intro + photo left (5 cols), form card right (7 cols).
// On phones the photo is hidden so the form starts on the first screen.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { photo } from '../data/photos';
---

{/* TODO: title and description drafted; owner to approve. */}
<Base
  title="Inquiries"
  description="Send a wedding hair and makeup inquiry to Jeanice Huang: your date, venue and the services you need."
>
  <section class="container-site pt-12 pb-section md:pt-20 md:pb-section-desktop">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-grid-gap">
      <div class="hero-rise space-y-6 lg:sticky lg:top-32 lg:col-span-5">
        <h1 class="text-display-lg-mobile md:text-display-lg">Inquiries</h1>
        {/* TODO: intro line drafted; owner to approve. */}
        <p class="max-w-measure text-body-lg">
          Tell me about your wedding: your date, your venue and who needs hair and makeup.
        </p>
        <Photo
          photo={photo('dana-28.webp')}
          alt="A bride in a lace gown standing at a bright window, seen from behind"
          sizes="(min-width: 1280px) 460px, 38vw"
          aspect="aspect-[4/5]"
          position="50% 40%"
          class="hidden pt-4 lg:block"
        />
      </div>

      <div class="lg:col-span-7">
        <InquiryForm />
      </div>
    </div>
  </section>
</Base>
