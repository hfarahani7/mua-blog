---
// Small uppercase label above a heading, with a short champagne rule (DESIGN.md → Typography).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p class:list={['inline-flex items-center gap-3 text-label-sm uppercase text-umber', className]}>
  <span aria-hidden="true" class="h-px w-8 bg-champagne"></span>
  <span><slot /></span>
</p>
