---
// Site footer (DESIGN.md → Components → Footer). Copy is the existing footer text.
const year = new Date().getFullYear();
const links = [
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Services', href: '/services' },
  { label: 'Inquiries', href: '/inquiries' },
];
---

<footer class="border-t border-line bg-canvas-mid">
  <div class="container-site py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="space-y-4 md:col-span-5">
        <p class="font-display text-headline-md uppercase tracking-tight text-ink">Jeanice Huang</p>
        <a
          href="https://www.instagram.com/mua__jeanice/"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline inline-block text-label-sm uppercase text-ink"
        >
          Instagram @mua__jeanice<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>

      <nav aria-label="Footer" class="md:col-span-3">
        <ul class="space-y-3">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-body-sm text-ink-soft transition-colors hover:text-ink">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <!-- TODO: link label drafted; owner to approve. -->
        <a href="/inquiries" class="link-underline inline-flex items-center gap-2 text-label-sm uppercase text-ink">
          Send an inquiry
          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25">
            <path d="M3 9L9 3M4 3h5v5" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-line pt-8 text-label-sm uppercase text-ink-soft md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} JEANICEHUANGMUA LLC. All Rights Reserved.</p>
      <p>
        Built by Henry Farahani 2025 &middot;{' '}<a href="https://henryfarahani.com" class="link-underline text-ink">henryfarahani.com</a>
      </p>
    </div>
  </div>
</footer>
