---
// CSS-only masonry gallery (CSS columns; no JavaScript, no library).
// Photos keep their own aspect ratio, each in a white hairline frame with the hover zoom.
// Column order runs top-to-bottom, then left-to-right.
// Alt text and order come from src/content/photos.json.
import Photo from './Photo.astro';
import type { PhotoEntry } from '../data/photos';

interface Props {
  id: string;
  title: string;
  photos: PhotoEntry[];
  /** Load the first N photos immediately (only for the gallery at the top of the page). */
  eagerCount?: number;
  tone?: 'low' | 'canvas';
}

const { id, title, photos, eagerCount = 0, tone = 'canvas' } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={['scroll-mt-20 border-t border-line py-section md:scroll-mt-24 md:py-section-desktop', tone === 'low' ? 'bg-canvas-low' : 'bg-canvas']}
>
  <div class="container-site">
    <div class="mb-10 flex items-baseline justify-between gap-6 md:mb-14">
      <h2 id={`${id}-title`} class="text-headline-lg-mobile md:text-headline-lg">{title}</h2>
      <p class="text-label-sm uppercase text-ink-soft tabular-nums">{photos.length} photos</p>
    </div>

    <ul class="columns-1 gap-6 sm:columns-2 lg:columns-3 lg:gap-8">
      {photos.map((p, i) => (
        <li class="mb-6 break-inside-avoid lg:mb-8">
          <Photo
            photo={p.image}
            alt={p.alt}
            sizes="(min-width: 1280px) 360px, (min-width: 1024px) 28vw, (min-width: 640px) 45vw, calc(100vw - 4rem)"
            natural
            framed
            eager={i < eagerCount}
          />
        </li>
      ))}
    </ul>
  </div>
</section>
