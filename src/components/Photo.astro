---
// A photo in a fixed-aspect, overflow-hidden frame (DESIGN.md → Image frame).
// Uses astro:assets: the build makes 400–1600px WebP versions and the browser picks one
// using `sizes`, so phones download small files. width/height come from the file itself.
import { Image } from 'astro:assets';
import type { Photo } from '../data/photos';

interface Props {
  photo: Photo;
  /** Meaningful alt text, or "" when the photo is decorative (e.g. inside a labelled link). */
  alt: string;
  /** How wide the photo is shown, as a `sizes` value, e.g. "(min-width: 1024px) 33vw, 100vw". */
  sizes: string;
  /** Tailwind aspect classes, e.g. "aspect-[4/5] md:aspect-[3/4]". */
  aspect?: string;
  /** CSS object-position for the crop, e.g. "50% 30%". */
  position?: string;
  /** White card frame with a hairline border and 12px padding. */
  framed?: boolean;
  /** Load immediately (the largest photo above the fold only). */
  eager?: boolean;
  /** From md up, ignore `aspect` and fill the grid row's height (to line up with a neighbour). */
  fillRow?: boolean;
  /** Use the photo's own aspect ratio, uncropped (masonry galleries). Overrides `aspect`. */
  natural?: boolean;
  class?: string;
}

const {
  photo,
  alt,
  sizes,
  aspect = 'aspect-[4/5]',
  position,
  framed = false,
  eager = false,
  fillRow = false,
  natural = false,
  class: className,
} = Astro.props;

// Generated widths, never larger than the stored file.
const widths = [400, 800, 1200, 1600].filter((w) => w < photo.width).concat(Math.min(photo.width, 2000));
---

<div class:list={[framed && 'border border-line bg-card p-2 md:p-3', fillRow && 'md:flex md:flex-col', className]}>
  <div
    class:list={['photo-zoom relative overflow-hidden bg-canvas-mid', !natural && aspect, fillRow && 'md:aspect-auto md:flex-1']}
    style={natural ? `aspect-ratio: ${photo.width} / ${photo.height}` : undefined}
  >
    <Image
      src={photo}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      class="absolute inset-0 size-full object-cover"
      style={position ? `object-position: ${position}` : undefined}
    />
  </div>
</div>
