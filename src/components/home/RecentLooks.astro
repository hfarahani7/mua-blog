---
// "Recent Looks": the four photos from the old home grid, in Stitch's asymmetric
// 7/5 then 5/7 grid. On phones they sit two per row, like the old site.
import Photo from '../Photo.astro';
import Arrow from '../Arrow.astro';
import { photoEntry } from '../../data/photos';

// Alt text comes from src/content/photos.json.
// NOTE: IMG_9555 and IMG_8632 are phone screenshots with black bars top and bottom; the crops
// below keep the bars out of frame. The old code had "not this one" comments next to
// IMG_6084 and IMG_8632 — owner to confirm these four are still the right picks.
const looks = [
  {
    photo: photoEntry('img-6084.webp').image,
    alt: photoEntry('img-6084.webp').alt,
    span: 'md:col-span-7',
    sizes: '(min-width: 1280px) 640px, (min-width: 768px) 55vw, 45vw',
    aspect: 'aspect-square md:aspect-[4/5]',
    position: '50% 22%',
  },
  {
    photo: photoEntry('img-4037.webp').image,
    alt: photoEntry('img-4037.webp').alt,
    span: 'md:col-span-5',
    sizes: '(min-width: 1280px) 460px, (min-width: 768px) 40vw, 45vw',
    aspect: 'aspect-square',
    position: '50% 30%',
    fillRow: true,
  },
  {
    photo: photoEntry('img-9555.webp').image,
    alt: photoEntry('img-9555.webp').alt,
    span: 'md:col-span-5',
    sizes: '(min-width: 1280px) 460px, (min-width: 768px) 40vw, 45vw',
    aspect: 'aspect-square',
    position: '50% 50%',
  },
  {
    photo: photoEntry('img-8632.webp').image,
    alt: photoEntry('img-8632.webp').alt,
    span: 'md:col-span-7',
    sizes: '(min-width: 1280px) 640px, (min-width: 768px) 55vw, 45vw',
    aspect: 'aspect-square',
    position: '50% 40%',
    fillRow: true,
  },
];
---

<section class="reveal border-t border-line bg-canvas-low py-section md:py-section-desktop" aria-labelledby="recent-looks">
  <div class="container-site">
    <div class="mb-12 flex flex-col justify-between gap-6 md:mb-16 md:flex-row md:items-end">
      <h2 id="recent-looks" class="text-headline-lg-mobile md:text-headline-lg">Recent Looks</h2>
      <a
        href="https://www.instagram.com/mua__jeanice/"
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline inline-flex items-center gap-2 self-start text-label-md uppercase text-ink md:self-auto"
      >
        Instagram @mua__jeanice<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-8">
      {looks.map((look) => (
        <Photo
          photo={look.photo}
          alt={look.alt}
          sizes={look.sizes}
          aspect={look.aspect}
          position={look.position}
          fillRow={look.fillRow}
          framed
          class={look.span}
        />
      ))}
    </div>

    <div class="mt-12 text-center md:mt-16">
      <a href="/portfolio" class="link-underline inline-flex items-center gap-3 text-label-md uppercase text-ink">
        View the full portfolio <Arrow />
      </a>
    </div>
  </div>
</section>
