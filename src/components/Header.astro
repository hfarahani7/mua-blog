---
// Site header (DESIGN.md → Components → Header). Same on every page.
// Desktop: wordmark, three links, "Inquire" button.
// Mobile: wordmark, "Inquire" button, Menu button that opens a full-screen <dialog>.
const links = [
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Services', href: '/services' },
  { label: 'Inquiries', href: '/inquiries' },
];
// build.format 'file' → pathname may be "/services.html" in the build.
const current = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas">
  <div class="container-site flex items-center justify-between gap-4 py-4 md:py-5">
    <a
      href="/"
      class="font-display text-headline-sm uppercase tracking-tight whitespace-nowrap text-ink sm:text-headline-md"
    >
      Jeanice Huang
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-10">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.href ? 'page' : undefined}
              class="inline-block border-b border-transparent pb-1 text-label-md uppercase text-ink-soft transition-colors hover:text-ink aria-[current=page]:border-ink aria-[current=page]:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/inquiries"
        class="inline-flex min-h-11 items-center bg-ink px-4 text-label-md uppercase text-on-ink transition-colors duration-300 hover:bg-ink-hover md:px-5"
      >
        Inquire
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center text-ink md:hidden"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25">
          <path d="M2 6h18M2 11h18M2 16h18" />
        </svg>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="mobile-menu"
  aria-label="Menu"
  class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-canvas p-0 text-ink md:hidden"
>
  <div class="container-site flex items-center justify-between py-4">
    <a href="/" class="font-display text-headline-sm uppercase tracking-tight text-ink">Jeanice Huang</a>
    <button type="button" class="inline-flex size-11 items-center justify-center" data-menu-close>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25">
        <path d="M4 4l14 14M18 4L4 18" />
      </svg>
      <span class="sr-only">Close menu</span>
    </button>
  </div>
  <nav aria-label="Mobile" class="container-site pt-12">
    <ul class="space-y-6">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={current === link.href ? 'page' : undefined}
            class="font-display text-headline-lg text-ink aria-[current=page]:italic"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<script>
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog?.close());
  // Close if the window grows past the mobile breakpoint while the menu is open.
  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
    if (e.matches) dialog?.close();
  });
</script>

<style>
  .mobile-menu[open] {
    animation: menu-fade 300ms var(--ease-editorial);
  }
  .mobile-menu::backdrop {
    background: transparent;
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
</style>
