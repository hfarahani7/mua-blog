---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page title; " | Jeanice Huang" is appended unless `fullTitle` is set. */
  title: string;
  /** Unique meta description for this page. */
  description: string;
  /** Use `title` as-is (for the home page). */
  fullTitle?: boolean;
  /** Absolute URL of the Open Graph image. Defaults to the home hero photo. */
  ogImage?: string;
  /** Keep this page out of search results (404). */
  noindex?: boolean;
}

const {
  title,
  description,
  fullTitle = false,
  // TODO: S3 serves .webp files with Content-Type image/jpeg, and some social sites
  // don't accept WebP previews. A 1200×630 JPEG in images/ would be more reliable.
  ogImage = 'https://dwxk3eiesmmgs.cloudfront.net/images/Kath_Matt_JeanLaurentGaudy_417.webp',
  noindex = false,
} = Astro.props;

const siteName = 'Jeanice Huang';
const pageTitle = fullTitle ? title : `${title} | ${siteName}`;

// build.format 'file' gives paths like /services.html; canonical URLs use the clean form.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fcf9f4" />

    {/* Open Graph / social previews */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link text-label-md uppercase">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
